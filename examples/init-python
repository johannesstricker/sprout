#!/bin/bash
# Example .sprout/init hook for a Python project
#
# Copy this file to .sprout/init in your repository to use it
# Make sure to make it executable: chmod +x .sprout/init

set -e

echo "🌱 Initializing worktree: $SPROUT_WORKTREE_NAME"

# Copy environment configuration from main repository
if [ -f "$SPROUT_REPO_ROOT/.env" ]; then
    cp "$SPROUT_REPO_ROOT/.env" .env
    echo "✓ Copied .env file"
fi

# Create and activate virtual environment
if [ -f "requirements.txt" ] || [ -f "setup.py" ] || [ -f "pyproject.toml" ]; then
    echo "🐍 Setting up Python virtual environment..."

    python -m venv venv
    source venv/bin/activate
    echo "✓ Virtual environment created"

    # Upgrade pip
    pip install --upgrade pip setuptools wheel

    # Install dependencies
    if [ -f "requirements.txt" ]; then
        pip install -r requirements.txt
        echo "✓ Requirements installed"
    elif [ -f "setup.py" ]; then
        pip install -e .
        echo "✓ Package installed in development mode"
    elif [ -f "pyproject.toml" ]; then
        pip install -e .
        echo "✓ Package installed in development mode"
    fi
fi

# Copy additional config files
if [ -f "$SPROUT_REPO_ROOT/.env.local" ]; then
    cp "$SPROUT_REPO_ROOT/.env.local" .env.local
    echo "✓ Copied .env.local"
fi

echo ""
echo "✅ Worktree initialization complete!"
echo "Working directory: $(pwd)"
echo ""
echo "To activate the virtual environment, run:"
echo "  source venv/bin/activate"
