#!/bin/bash
# Example .sprout/init hook for a Node.js project
#
# Copy this file to .sprout/init in your repository to use it
# Make sure to make it executable: chmod +x .sprout/init

set -e

echo "🌱 Initializing worktree: $SPROUT_WORKTREE_NAME"

# Copy environment configuration from main repository
if [ -f "$SPROUT_REPO_ROOT/.env" ]; then
    cp "$SPROUT_REPO_ROOT/.env" .env
    echo "✓ Copied .env file"
else
    if [ -f "$SPROUT_REPO_ROOT/.env.example" ]; then
        cp "$SPROUT_REPO_ROOT/.env.example" .env
        echo "✓ Copied .env.example as .env"
    fi
fi

# Install dependencies
if [ -f "package.json" ]; then
    echo "📦 Installing dependencies..."
    npm install
    echo "✓ Dependencies installed"
fi

# Setup pre-commit hooks
if [ -d "$SPROUT_REPO_ROOT/.git/hooks" ] && [ -f "$SPROUT_REPO_ROOT/.husky/_" ]; then
    echo "🔗 Setting up git hooks..."
    npm run prepare 2>/dev/null || true
    echo "✓ Git hooks configured"
fi

echo ""
echo "✅ Worktree initialization complete!"
echo "Working directory: $(pwd)"
